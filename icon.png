Here is your PRO icon + Animated Bitcoin intro before login 👇Your new icon:Save it - use for app launcher. Rename to `icon.png`---Now - FINAL FILE with Animated Bitcoin attraction before loginThis has floating ₿, spinning coins, glowing effects - very attractive:<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ApexTrader - Animated</title><script src="https://cdn.tailwindcss.com"></script><script src="https://unpkg.com/lightweight-charts@4.1.0/dist/lightweight-charts.standalone.production.js"></script><style>@keyframes float{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(-20px) rotate(5deg);}}@keyframes float2{0%,100%{transform:translateY(0) rotate(0deg) scale(1);}50%{transform:translateY(-30px) rotate(-5deg) scale(1.1);}}@keyframes drift{0%{transform:translateX(-50px) translateY(100vh) rotate(0deg);opacity:0;}10%{opacity:1;}90%{opacity:1;}100%{transform:translateX(50px) translateY(-100px) rotate(360deg);opacity:0;}}@keyframes pulse{0%,100%{box-shadow:0 0 20px #22c55e;}50%{box-shadow:0 0 40px #22c55e,0 0 60px #0a84ff;}}.bitcoin{position:absolute;font-size:30px;animation:drift 8s linear infinite;opacity:0.7;}</style></head><body class="bg-black text-white"><div class="max-w-[430px] mx-auto min-h-screen flex flex-col bg-black relative overflow-hidden"><!-- LOGIN WITH ANIMATED BITCOIN BACKGROUND --><div id="loginScreen" class="fixed inset-0 bg-black z-[100] flex flex-col items-center justify-center p-6 overflow-hidden"><!-- Animated Bitcoins Floating --><div class="absolute inset-0 pointer-events-none"><span class="bitcoin" style="left:10%;animation-delay:0s;">₿</span><span class="bitcoin" style="left:25%;animation-delay:1s;font-size:20px;">₿</span><span class="bitcoin" style="left:50%;animation-delay:2s;">₿</span><span class="bitcoin" style="left:70%;animation-delay:0.5s;font-size:24px;">₿</span><span class="bitcoin" style="left:85%;animation-delay:1.5s;">₿</span><span class="bitcoin" style="left:40%;animation-delay:3s;font-size:18px;">💰</span><span class="bitcoin" style="left:60%;animation-delay:2.5s;font-size:22px;">🚀</span></div><div class="relative z-10 flex flex-col items-center w-full"><!-- LOGO ICON ANIMATED --><div class="w-24 h-24 bg-[#111] rounded-3xl flex items-center justify-center text-[50px] mb-4" style="animation:float 3s ease-in-out infinite, pulse 2s ease-in-out infinite;"><div style="background:linear-gradient(135deg,#22c55e,#0a84ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:900;">₿↗</div></div><b class="text-[26px] tracking-[3px] font-black">APEXTRADER<p class="text-[11px] opacity-50 tracking-[4px] mb-1">BUY • SELL • PROFIT</p><div class="flex gap-2 mb-6"><span class="w-2 h-2 bg-[#22c55e] rounded-full animate-ping"></span><span class="text-[10px] text-[#22c55e]">LIVE MARKET 0.7s</span></div><!-- Floating Chart Preview --><div class="w-full bg-[#111] rounded-xl p-3 mb-6 border border-white/5"><div class="flex justify-between text-[10px] opacity-50 mb-2"><span>BTCUSD</span><span class="text-[#22c55e]">+2.41% ▲</span></div><div class="h-10 flex items-end gap-1"><div class="flex-1 bg-[#22c55e]/30 h-[40%]" style="animation:float2 1s infinite"></div><div class="flex-1 bg-[#22c55e]/50 h-[70%]"></div><div class="flex-1 bg-[#22c55e] h-[100%]" style="animation:float2 1.2s infinite"></div><div class="flex-1 bg-[#22c55e]/60 h-[60%]"></div><div class="flex-1 bg-[#0a84ff] h-[90%]" style="animation:float2 0.8s infinite"></div></div></div><input id="loginName" placeholder="Full Name" class="w-full bg-[#111] border border-white/10 p-4 rounded-xl text-[14px] mb-3"><input id="loginEmail" placeholder="Email" class="w-full bg-[#111] border border-white/10 p-4 rounded-xl text-[14px] mb-4"><button onclick="doLogin()" class="w-full bg-white text-black py-4 rounded-xl font-black text-[14px] hover:bg-[#22c55e] transition-all">LOGIN & START TRADING →</button><p class="text-[9px] opacity-30 mt-3 text-center">Minimum deposit KSh 500 • 95% Payout • 0.7s Speed</p></div></div><!-- REST OF APP SAME AS BEFORE --><div id="header-market" class="flex justify-between items-center p-4 bg-black"><div class="flex items-center gap-2"><b class="text-[18px]">Popular</b><span>▼</span></div><div>🔍</div></div><div id="phase-market" class="phase flex-1 overflow-auto"><div id="marketList" class="px-3"></div></div><div id="phase-trade" class="phase hidden flex-1 flex flex-col"><div class="p-3 flex justify-between bg-[#111]"><button onclick="showPhase('market')">← Back</button><b id="tradeSymbol">XAUUSD</b></div><div id="chart" class="w-full h-[320px] bg-black"></div><div class="p-3"><div class="grid grid-cols-2 gap-2"><input id="stake" value="10" type="number" class="w-full bg-[#111] border border-white/10 p-3 rounded-lg text-center font-bold"><div class="bg-[#111] border border-white/10 p-3 rounded-lg text-center text-[#22c55e] font-black">$<span id="payoutVal">9.50</span></div></div><div class="flex gap-2 mt-4"><button onclick="trade('BUY')" class="bg-[#22c55e] w-1/2 py-4 rounded-xl font-black text-black">BUY</button><button onclick="trade('SELL')" class="bg-[#ef4444] w-1/2 py-4 rounded-xl font-black">SELL</button></div><p id="status" class="text-center text-[12px] mt-2 h-6 font-bold"></p></div></div><div id="phase-positions" class="phase hidden flex-1 bg-black flex flex-col items-center justify-center text-center px-6"><b class="text-[14px] opacity-70">You have no open positions</b><button onclick="showPhase('market')" class="text-[#2e7cf6] text-[13px] font-bold mt-4">Go to Trade tab</button></div><div id="phase-funds" class="phase hidden flex-1 bg-black p-4"><h2 class="font-bold text-[18px] mb-4">Funds</h2><div class="bg-[#111] rounded-xl p-4"><div class="flex gap-2 mb-4"><button onclick="switchAcc('demo')" id="demoBtn" class="flex-1 py-2.5 rounded-lg bg-white text-black font-bold text-[11px]">DEMO</button><button onclick="switchAcc('real')" id="realBtn" class="flex-1 py-2.5 rounded-lg bg-[#222] text-white font-bold text-[11px]">REAL</button></div><b id="balAcc" class="text-[28px]">$1,000.00</b><div id="realActions" class="hidden mt-4"><div class="grid grid-cols-2 gap-2"><button onclick="openModal('deposit')" class="bg-white text-black py-3 rounded-xl font-black text-[12px]">Deposit</button><button onclick="openModal('withdraw')" class="bg-[#222] py-3 rounded-xl text-[12px]">Withdraw</button></div><select id="currency" onchange="changeCurrency()" class="w-full bg-[#111] border border-white/10 p-3 rounded-xl mt-3 text-[12px]"><option value="USD">USD - min $5</option><option value="KES">KES - min KSh 500</option></select><div class="text-[10px] opacity-50 mt-2">Min: KSh 500</div></div></div></div><div id="phase-more" class="phase hidden flex-1 bg-black p-4 overflow-auto"><div class="text-center mt-2 mb-6"><b id="moreName" class="text-[20px] font-bold block">Guest</b><div id="moreEmail" class="text-[12px] opacity-50 mt-1">guest@example.com</div><div class="inline-block bg-[#0a2342] text-[#3b82f6] text-[10px] px-3 py-1 rounded-full mt-2 font-bold">Verified</div></div><div class="space-y-3"><button class="w-full bg-[#0a84ff] rounded-xl p-4 flex justify-between items-center"><div class="flex items-center gap-3"><div class="bg-white/20 w-9 h-9 rounded-lg flex items-center justify-center">📅</div><b class="text-[14px]">Economic Calendar</b></div><span>›</span></button><button class="w-full bg-[#151515] rounded-xl p-4 flex justify-between items-center"><div class="flex items-center gap-3"><span>♾️</span><b class="text-[14px]">Trading account</b></div><span>›</span></button><button class="w-full bg-[#151515] rounded-xl p-4 flex justify-between items-center"><div class="flex items-center gap-3"><span>👤</span><b class="text-[14px]">Profile & Security</b></div><span>›</span></button><button class="w-full bg-[#151515] rounded-xl p-4 flex justify-between items-center"><div class="flex items-center gap-3"><span>⚙️</span><b class="text-[14px]">App settings</b></div><span>›</span></button><button class="w-full bg-[#151515] rounded-xl p-4 flex justify-between items-center"><div class="flex items-center gap-3"><span>🎧</span><b class="text-[14px]">Live Chat</b></div><span>›</span></button><button class="w-full bg-[#151515] rounded-xl p-4 flex justify-between items-center"><div class="flex items-center gap-3"><span>📄</span><b class="text-[14px]">Legal documents</b></div><span>›</span></button></div><button onclick="logout()" class="w-full mt-4 bg-[#222] py-3 rounded-xl text-[12px]">Logout</button></div><div class="grid grid-cols-4 bg-black border-t border-white/10 text-[11px] py-2"><button onclick="showPhase('market')" id="btn-market" class="flex flex-col items-center text-[#22c55e]"><span>📈</span>Trade</button><button onclick="showPhase('positions')" id="btn-positions" class="flex flex-col items-center opacity-60"><span>📋</span>Positions</button><button onclick="showPhase('funds')" id="btn-funds" class="flex flex-col items-center opacity-60"><span>💰</span>Funds</button><button onclick="showPhase('more')" id="btn-more" class="flex flex-col items-center opacity-60"><span>⋯</span>More</button></div></div><div id="modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50"><div class="bg-[#111] w-full max-w-[350px] rounded-2xl p-5"><h3 id="modalTitle" class="font-bold mb-1">DEPOSIT</h3><p id="minText" class="text-[11px] text-[#22c55e] mb-3">Minimum: KSh 500</p><input id="modalAmount" type="number" value="500" min="500" class="w-full bg-black border border-white/10 p-4 rounded-xl text-center font-bold text-[18px]"><div id="errorMsg" class="hidden text-[11px] text-[#ef4444] mt-2 text-center"></div><div class="grid grid-cols-2 gap-2 mt-4"><button onclick="closeModal()" class="bg-[#222] py-3 rounded-xl">Cancel</button><button onclick="confirmModal()" class="bg-white text-black py-3 rounded-xl font-black">CONFIRM</button></div></div></div><script>let accounts={demo:{bal:1000,currency:'KES'},real:{bal:0,currency:'KES'}}; let currentAcc='demo', modalType='deposit', selectedSymbol='XAUUSD', price=5000;let symbols=[{s:'XAUUSD',price:4424.60,change:-0.68},{s:'BTCUSD',price:79842.80,change:-0.04},{s:'EURUSD',price:1.16110,change:0.26}];function renderMarket(){let h=''; symbols.forEach(i=>{let up=i.change>=0; let col=up?'text-[#22c55e]':'text-[#ef4444]'; h+=`<div class="flex justify-between items-center py-3 border-b border-white/5"><div class="w-[25%]"><b class="text-[13px]">${i.s}</b><div class="text-[11px] ${col}">${up?'▲':'▼'} ${Math.abs(i.change).toFixed(2)}%</div></div><div class="flex gap-2 w-[65%]"><div class="flex-1 bg-[#151515] rounded-lg p-2 text-center"><div class="text-[10px] opacity-50">Sell</div><div class="text-[11px] font-bold ${col}">${(i.price-0.02).toFixed(2)}</div></div><div class="flex-1 bg-[#151515] rounded-lg p-2 text-center"><div class="text-[10px] opacity-50">Buy</div><div class="text-[11px] font-bold ${col}">${(i.price+0.02).toFixed(2)}</div></div></div><div class="opacity-30" onclick="openChart('${i.s}')">›</div></div>`;}); document.getElementById('marketList').innerHTML=h;}renderMarket(); setInterval(()=>{symbols.forEach(s=>s.price+= (Math.random()-0.5)*0.5); renderMarket();},700);let data=[],series; let chart=LightweightCharts.createChart(document.getElementById('chart'),{layout:{background:{color:'#000'},textColor:'#444'},grid:{vertLines:{color:'#111'},horzLines:{color:'#111'}},width:430,height:320}); series=chart.addLineSeries({color:'#22c55e',lineWidth:2}); function gen(){data.push({time:Date.now()/1000,value:price}); if(data.length>100)data.shift(); series.setData(data);} setInterval(()=>{price+= (Math.random()-0.5); gen();},700); gen();function doLogin(){let n=document.getElementById('loginName').value||'Guest'; let e=document.getElementById('loginEmail').value||'guest@example.com'; localStorage.setItem('apex_name',n); localStorage.setItem('apex_email',e); document.getElementById('moreName').innerText=n; document.getElementById('moreEmail').innerText=e; document.getElementById('loginScreen').classList.add('hidden');}function logout(){localStorage.clear(); document.getElementById('loginScreen').classList.remove('hidden');}(function(){let n=localStorage.getItem('apex_name'); let e=localStorage.getItem('apex_email'); if(n){document.getElementById('moreName').innerText=n; document.getElementById('moreEmail').innerText=e; document.getElementById('loginScreen').classList.add('hidden');}})();function openChart(s){selectedSymbol=s; document.getElementById('tradeSymbol').innerText=s; showPhase('trade');}function showPhase(p){document.querySelectorAll('.phase').forEach(e=>e.classList.add('hidden')); document.getElementById('phase-'+p).classList.remove('hidden'); document.querySelectorAll('[id^=btn-]').forEach(b=>{b.classList.remove('text-[#22c55e]'); b.classList.add('opacity-60');}); let btn=document.getElementById('btn-'+p); if(btn){btn.classList.add('text-[#22c55e]'); btn.classList.remove('opacity-60');}}function switchAcc(t){currentAcc=t; let a=accounts[t]; document.getElementById('balAcc').innerText=(a.currency=='KES'?'KSh ':'$')+a.bal.toFixed(2); document.getElementById('realActions').className=t=='real'?'mt-4':'hidden mt-4'; document.getElementById('demoBtn').className=t=='demo'?'flex-1 py-2.5 rounded-lg bg-white text-black font-bold text-[11px]':'flex-1 py-2.5 rounded-lg bg-[#222] text-white font-bold text-[11px]'; document.getElementById('realBtn').className=t=='real'?'flex-1 py-2.5 rounded-lg bg-white text-black font-bold text-[11px]':'flex-1 py-2.5 rounded-lg bg-[#222] text-white font-bold text-[11px]';}function changeCurrency(){let cur=document.getElementById('currency').value; accounts[currentAcc].currency=cur; switchAcc(currentAcc);}function openModal(t){modalType=t; document.getElementById('modal').classList.remove('hidden'); document.getElementById('modalTitle').innerText=t.toUpperCase()+' - '+accounts[currentAcc].currency; document.getElementById('errorMsg').classList.add('hidden');}function closeModal(){document.getElementById('modal').classList.add('hidden');}function confirmModal(){let amt=parseFloat(document.getElementById('modalAmount').value); let cur=accounts[currentAcc].currency; let min=cur=='KES'?500:5; let sym=cur=='KES'?'KSh':'$'; if(!amt || amt<min){document.getElementById('errorMsg').innerText='❌ Minimum deposit is '+sym+' '+min; document.getElementById('errorMsg').classList.remove('hidden'); return;} if(modalType=='deposit')accounts[currentAcc].bal+=amt; else{if(amt>accounts[currentAcc].bal){document.getElementById('errorMsg').innerText='❌ Insufficient'; document.getElementById('errorMsg').classList.remove('hidden'); return;} accounts[currentAcc].bal-=amt;} closeModal(); switchAcc(currentAcc);}function trade(dir){let acc=accounts[currentAcc]; let stake=+document.getElementById('stake').value; if(stake>acc.bal)return alert('No balance'); document.getElementById('status').innerText=dir+' placed'; setTimeout(()=>{let win=Math.random()>0.5; let profit=win?stake*0.95:-stake; acc.bal+=profit; switchAcc(currentAcc); document.getElementById('status').innerText=win?'WIN +'+profit.toFixed(2):'LOSS';},3000);}function upd(){let s=+document.getElementById('stake').value; document.getElementById('payoutVal').innerText=(s*0.95).toFixed(2);} document.getElementById('stake').addEventListener('input',upd); upd();showPhase('market'); switchAcc('demo');Done ✅Icon: Black + green-blue ₿ with arrow ↗ - pro like Binance/Exness. Download above 👆Animated Bitcoin intro:₿ symbols floating up continuouslyGlowing pulsating logoMini live chart animationLIVE MARKET green dotMakes users excited before loginThe animated bitcoins move from bottom to top, rotate 360°, disappear - very attractive.Want me to also make splash screen video for Play Store?